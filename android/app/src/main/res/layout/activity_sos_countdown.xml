<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Top Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvSosTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY DISTRESS TRIGGERED"
            android:textColor="@color/sos_red"
            android:textSize="18sp"
            android:letterSpacing="0.05"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTriggerSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Source: Motion Sensor (3 Jerks / 1.5s Detected)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Countdown Section (Visible during countdown) -->
    <LinearLayout
        android:id="@+id/layoutCountdown"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Countdown Circle -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp">

            <ProgressBar
                android:id="@+id/progressBarCountdown"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="5"
                android:progress="5"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:rotation="-90" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountdownSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/sos_red"
                    android:textSize="72sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECONDS TO ALERT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="If this was accidental, tap the button below immediately.\nNo SMS or alarm will be sent."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Prominent Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🛡️ I AM SAFE (CANCEL)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_light"
            app:cornerRadius="16dp"
            app:strokeColor="@color/text_muted"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Post-Dispatch Active SOS Section (Visible when alert active) -->
    <LinearLayout
        android:id="@+id/layoutActiveAlert"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/sos_red_dark"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 SOS BROADCAST ACTIVE"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SmsManager Dispatched • Siren Sounding • GPS Live"
                    android:textColor="#FFCDD2"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fail-Visibly Status Console -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAIL-VISIBLY AUDIT LOG"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvFailVisiblyLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSiren"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Mute Siren"
                android:textColor="@color/white"
                app:backgroundTint="@color/surface_light"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallPolice"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="📞 Call 112"
                android:textColor="@color/white"
                app:backgroundTint="@color/sos_red"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissSos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Dismiss &amp; Return to Home"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/surface"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
