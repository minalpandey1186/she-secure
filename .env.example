# ==============================================================================
# SHESECURE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in each application directory and configure appropriate secrets.
# NEVER commit production .env files to version control!
# ==============================================================================

# --- DATABASE CONFIGURATION ---
POSTGRES_DB=shesecure
POSTGRES_USER=shesecure_user
POSTGRES_PASSWORD=shesecure_secret_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shesecure_user:shesecure_secret_password@localhost:5432/shesecure?schema=public

# --- BACKEND SERVER CONFIGURATION ---
NODE_ENV=development
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- JWT AUTHENTICATION ---
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_change_in_production
JWT_EXPIRES_IN=24h

# --- ENCRYPTION (AES-256-GCM) ---
# 256-bit hexadecimal master key (64 hex characters)
ENCRYPTION_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEFAULT_KEY_ID=key-v1

# --- TELEGRAM EMERGENCY GATEWAY ---
# Configure Bot Token and Responder Chat ID for emergency alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DASHBOARD CONFIGURATION ---
DASHBOARD_PORT=5173
VITE_API_URL=http://localhost:4000/api/v1

# --- MOBILE APP CONFIGURATION ---
# Points to the backend endpoint (use 10.0.2.2 for Android Emulator, or host IP)
MOBILE_API_BASE_URL=http://10.0.2.2:4000/api/v1
MOBILE_DEFAULT_KEY_ID=key-v1
MOBILE_SECRET_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
